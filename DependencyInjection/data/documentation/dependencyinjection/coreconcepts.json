) { AnalyticsService() }","static let session = Factory(scope: .shared) { Session() }"]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Scope","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Behavior","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Use it for","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/DependencyInjection\/documentation\/DependencyInjection\/Scope\/unique"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A new instance on every resolution"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Stateless services, value types, or anything you want fresh each time"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/DependencyInjection\/documentation\/DependencyInjection\/Scope\/cached","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"Created once and held strongly","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Singletons that live as long as the app"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/DependencyInjection\/documentation\/DependencyInjection\/Scope\/shared","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"Created once and held weakly; created again once every outside reference is gone","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shared resources that should be freed when nothing uses them"}]}]]],"header":"row"},{"inlineContent":[{"type":"text","text":"Each container has its own cache. A test container caches its own instances, so a "},{"code":".cached","type":"codeVoice"},{"type":"text","text":" singleton from one test never shows up in production code or in another test."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"With "},{"type":"codeVoice","code":".cached"},{"type":"text","text":" or "},{"