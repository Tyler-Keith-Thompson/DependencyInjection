{"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Factories","level":2,"anchor":"Factories"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A factory registers one dependency. It wraps a closure that creates the dependency, and registers itself with the default container when it is created."}]},{"type":"codeListing","syntax":"swift","code":["extension Container {","    static let logger = Factory { ConsoleLogger() as Logger }      \/\/ sync","    static let config = Factory { try loadConfig() }               \/\/ sync throwing","    static let session = Factory { await URLSession.shared }       \/\/ async","    static let database = Factory { try await Database.connect() } \/\/ async throwing","}"]},{"type":"paragraph","inlineContent":[{"text":"The closure’s signature decides which factory type you get:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Closure signature","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Factory type","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"() -> T"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/DependencyInjection\/documentation\/DependencyInjection\/SyncFactory","type":"reference"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"() throws -> T","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/DependencyInjection\/documentation\/DependencyInjection\/SyncThrowingFactory","isActive":true}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"() async -> T"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/DependencyInjection\/documentation\/DependencyInjection\/AsyncFactory","isActive":true,"type":"reference"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"() async throws -> T","type":"codeVoice"}],"type":"paragraph"}],[{"